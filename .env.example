# Antler Foods SEO Automation — environment configuration template.
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# Placeholders only below — no real credentials.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Antler CMS login email
ANTLER_EMAIL=your-email@example.com

# Antler CMS login password
ANTLER_PASSWORD=your-password-here

# Antler CMS base URL (must start with http:// or https://)
ANTLER_BASE_URL=https://your-antler-cms-url.example.com

# ---------------------------------------------------------------------------
# Optional runtime settings (defaults shown)
# ---------------------------------------------------------------------------

# Run the browser without a visible window (true/false)
ANTLER_HEADLESS=false

# Default Playwright timeout in milliseconds (>= 1000)
ANTLER_TIMEOUT=30000

# Delay between browser operations in milliseconds (debugging aid, >= 0)
ANTLER_SLOW_MO=100

# Directory containing local SEO input documents
ANTLER_SEO_DIR=seo_files

# Directory for log files
ANTLER_LOGS_DIR=logs

# ---------------------------------------------------------------------------
# Cloud input (Google Sheet + Google Doc) — optional
# Only needed for the Google Sheet/Doc input source. Uses OAuth 2.0 installed-app
# authorization (browser consent on first run). Steps:
#   1. In Google Cloud, enable the Google Sheets API and Google Docs API.
#   2. Create an OAuth client ID of type "Desktop app" and download its JSON.
#   3. Save it as credentials.json (git-ignored) and point
#      ANTLER_GOOGLE_CREDENTIALS_FILE at it.
#   4. On first run a browser opens to grant access; the authorized token is
#      cached at ANTLER_GOOGLE_TOKEN_FILE (token.json, git-ignored) and reused.
# NEVER commit credentials.json or token.json.
# ---------------------------------------------------------------------------

# Path to the OAuth installed-app client config (downloaded from Google Cloud)
ANTLER_GOOGLE_CREDENTIALS_FILE=credentials.json

# Path to the cached OAuth user token (created automatically on first run)
ANTLER_GOOGLE_TOKEN_FILE=token.json

# Control-panel Google Sheet (URL or bare spreadsheet id)
ANTLER_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit
